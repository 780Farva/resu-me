#!/usr/bin/env python3
"""Kanban-style board over applications/ and grants/, plus a TODO.md view.

Reads every opportunity.md's **Status:** line and lays them out by state, the same
states AGENTS.md defines (open / submitted / interviewing / closed - *). Stdlib only —
curses for the interactive board, with a plain-text --list fallback for non-tty use
(piping, CI, this script's own smoke test).
"""
from __future__ import annotations

import curses
import re
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path

STATUS_RE = re.compile(
    r"\*\*Status:\*\*\s*"
    r"(?P<state>open|submitted|interviewing|closed - won|closed - lost|closed - declined|closed - lapsed)"
    r"\s*,\s*(?P<date>\d{4}-\d{2}-\d{2})\s*(?:\((?P<note>[^)]*)\))?"
)
TITLE_RE = re.compile(r"^#\s+(.+?)\s*$", re.MULTILINE)
TODO_ITEM_RE = re.compile(r"^\s*-\s*\[( |x|X)\]\s*(.+)$")

COLUMN_ORDER = ["open", "submitted", "interviewing", "closed"]
COLUMN_LABEL = {
    "open": "Open",
    "submitted": "Submitted",
    "interviewing": "Interviewing",
    "closed": "Closed",
}
CLOSED_TAG = {
    "closed - won": "WON",
    "closed - lost": "LOST",
    "closed - declined": "DECLINED",
    "closed - lapsed": "LAPSED",
}


@dataclass
class Opportunity:
    path: Path
    dir_name: str
    kind: str  # "job" | "grant"
    title: str
    state: str
    status_date: str
    note: str
    body: str
    todo: "TodoSection | None" = None

    @property
    def column(self) -> str:
        return "closed" if self.state.startswith("closed") else self.state

    @property
    def tag(self) -> str | None:
        return CLOSED_TAG.get(self.state)


@dataclass
class TodoSection:
    heading: str
    lines: list[str] = field(default_factory=list)

    @property
    def open_items(self) -> list[str]:
        items = []
        for line in self.lines:
            m = TODO_ITEM_RE.match(line)
            if m and m.group(1) == " ":
                items.append(m.group(2).strip())
        return items

    @property
    def done_items(self) -> list[str]:
        items = []
        for line in self.lines:
            m = TODO_ITEM_RE.match(line)
            if m and m.group(1) in ("x", "X"):
                items.append(m.group(2).strip())
        return items


def repo_root() -> Path:
    out = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
    )
    return Path(out.stdout.strip())


def parse_opportunity(path: Path, kind: str) -> Opportunity | None:
    text = path.read_text(encoding="utf-8")
    m_status = STATUS_RE.search(text)
    if not m_status:
        return None
    m_title = TITLE_RE.search(text)
    title = m_title.group(1) if m_title else path.parent.name
    return Opportunity(
        path=path,
        dir_name=path.parent.name,
        kind=kind,
        title=title,
        state=m_status.group("state"),
        status_date=m_status.group("date"),
        note=(m_status.group("note") or "").strip(),
        body=text,
    )


def discover(root: Path) -> list[Opportunity]:
    opps = []
    for kind, base in (("job", "applications"), ("grant", "grants")):
        for sub in (root / base, root / base / "completed"):
            if not sub.is_dir():
                continue
            for entry in sorted(sub.iterdir()):
                opp_file = entry / "opportunity.md"
                if opp_file.is_file():
                    opp = parse_opportunity(opp_file, kind)
                    if opp:
                        opps.append(opp)
    return opps


def parse_todo(path: Path) -> list[TodoSection]:
    if not path.is_file():
        return []
    sections: list[TodoSection] = []
    current: TodoSection | None = None
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("## "):
            current = TodoSection(heading=line[3:].strip())
            sections.append(current)
        elif current is not None:
            current.lines.append(line)
    return sections


def match_todo(opp: Opportunity, sections: list[TodoSection]) -> TodoSection | None:
    for section in sections:
        heading = section.heading.rstrip(".").strip().lower()
        if not heading:
            continue
        if heading in opp.title.lower() or opp.title.lower().startswith(heading):
            return section
    return None


def load(root: Path) -> list[Opportunity]:
    opps = discover(root)
    sections = parse_todo(root / "TODO.md")
    for opp in opps:
        opp.todo = match_todo(opp, sections)
    opps.sort(key=lambda o: (o.status_date, o.dir_name), reverse=True)
    return opps


# ---------------------------------------------------------------------------
# Plain-text fallback (non-tty, --list, smoke testing)
# ---------------------------------------------------------------------------


def print_plain(opps: list[Opportunity]) -> None:
    for col in COLUMN_ORDER:
        col_opps = [o for o in opps if o.column == col]
        print(f"== {COLUMN_LABEL[col]} ({len(col_opps)}) ==")
        if not col_opps:
            print("  (none)")
        for o in col_opps:
            tag = f" [{o.tag}]" if o.tag else ""
            flag = " !" if o.todo and o.todo.open_items else ""
            print(f"  - {o.title}{tag}  ({o.kind}, {o.status_date}){flag}")
            if o.note:
                print(f"      {o.note}")
        print()


# ---------------------------------------------------------------------------
# Curses UI
# ---------------------------------------------------------------------------


def safe_addstr(win, y, x, text, attr=0) -> None:
    max_y, max_x = win.getmaxyx()
    if y < 0 or y >= max_y or x >= max_x:
        return
    try:
        win.addstr(y, x, text[: max(0, max_x - x)], attr)
    except curses.error:
        pass


def clip(text: str, width: int) -> str:
    if width <= 0:
        return ""
    if len(text) <= width:
        return text
    if width == 1:
        return text[0]
    return text[: width - 1] + "…"


COL_PAIR = {"open": 1, "submitted": 2, "interviewing": 3, "closed": 4}


class Board:
    def __init__(self, stdscr, root: Path):
        self.stdscr = stdscr
        self.root = root
        self.opps = load(root)
        self.todo_sections = parse_todo(root / "TODO.md")
        self.col = 0
        self.row = {c: 0 for c in COLUMN_ORDER}
        self.mode = "board"  # "board" | "detail" | "todo"
        self.scroll = 0
        self.message = ""

        curses.curs_set(0)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN, -1)
        curses.init_pair(2, curses.COLOR_YELLOW, -1)
        curses.init_pair(3, curses.COLOR_MAGENTA, -1)
        curses.init_pair(4, curses.COLOR_WHITE, -1)
        curses.init_pair(5, curses.COLOR_BLACK, curses.COLOR_WHITE)  # selection
        curses.init_pair(6, curses.COLOR_GREEN, -1)  # won / open todo item
        curses.init_pair(7, curses.COLOR_RED, -1)  # lost
        curses.init_pair(8, curses.COLOR_YELLOW, -1)  # declined
        curses.init_pair(9, curses.COLOR_BLUE, -1)  # lapsed
        self.tag_pair = {
            "WON": 6,
            "LOST": 7,
            "DECLINED": 8,
            "LAPSED": 9,
        }

    def opps_in(self, col: str) -> list[Opportunity]:
        return [o for o in self.opps if o.column == col]

    def selected(self) -> Opportunity | None:
        col = COLUMN_ORDER[self.col]
        items = self.opps_in(col)
        if not items:
            return None
        idx = min(self.row[col], len(items) - 1)
        return items[idx]

    def reload(self) -> None:
        self.opps = load(self.root)
        self.todo_sections = parse_todo(self.root / "TODO.md")
        self.message = "reloaded"

    def run(self) -> None:
        while True:
            self.draw()
            key = self.stdscr.getch()
            if key == curses.KEY_RESIZE:
                continue
            if self.mode == "board":
                if not self.handle_board_key(key):
                    return
            elif self.mode == "detail":
                self.handle_detail_key(key)
            elif self.mode == "todo":
                self.handle_todo_key(key)

    def handle_board_key(self, key) -> bool:
        self.message = ""
        if key in (ord("q"), 27):
            return False
        if key in (curses.KEY_LEFT, ord("h")):
            self.col = (self.col - 1) % len(COLUMN_ORDER)
        elif key in (curses.KEY_RIGHT, ord("l")):
            self.col = (self.col + 1) % len(COLUMN_ORDER)
        elif key in (curses.KEY_UP, ord("k")):
            col = COLUMN_ORDER[self.col]
            if self.opps_in(col):
                self.row[col] = (self.row[col] - 1) % len(self.opps_in(col))
        elif key in (curses.KEY_DOWN, ord("j")):
            col = COLUMN_ORDER[self.col]
            if self.opps_in(col):
                self.row[col] = (self.row[col] + 1) % len(self.opps_in(col))
        elif key in (curses.KEY_ENTER, 10, 13, ord(" ")):
            if self.selected():
                self.mode = "detail"
                self.scroll = 0
        elif key == ord("t"):
            self.mode = "todo"
            self.scroll = 0
        elif key == ord("r"):
            self.reload()
        return True

    def handle_detail_key(self, key) -> None:
        if key in (ord("q"), 27, ord("b")):
            self.mode = "board"
        elif key in (curses.KEY_UP, ord("k")):
            self.scroll = max(0, self.scroll - 1)
        elif key in (curses.KEY_DOWN, ord("j")):
            self.scroll += 1
        elif key in (curses.KEY_NPAGE,):
            self.scroll += 10
        elif key in (curses.KEY_PPAGE,):
            self.scroll = max(0, self.scroll - 10)

    def handle_todo_key(self, key) -> None:
        if key in (ord("q"), 27, ord("b"), ord("t")):
            self.mode = "board"
        elif key in (curses.KEY_UP, ord("k")):
            self.scroll = max(0, self.scroll - 1)
        elif key in (curses.KEY_DOWN, ord("j")):
            self.scroll += 1
        elif key in (curses.KEY_NPAGE,):
            self.scroll += 10
        elif key in (curses.KEY_PPAGE,):
            self.scroll = max(0, self.scroll - 10)

    # -- drawing --------------------------------------------------------

    def draw(self) -> None:
        self.stdscr.erase()
        if self.mode == "board":
            self.draw_board()
        elif self.mode == "detail":
            self.draw_detail()
        elif self.mode == "todo":
            self.draw_todo()
        self.stdscr.refresh()

    def draw_header(self, title: str) -> None:
        max_y, max_x = self.stdscr.getmaxyx()
        bar = clip(f" resu-me — {title} ", max_x)
        safe_addstr(self.stdscr, 0, 0, bar.ljust(max_x), curses.A_REVERSE)

    def draw_footer(self, hint: str) -> None:
        max_y, max_x = self.stdscr.getmaxyx()
        safe_addstr(self.stdscr, max_y - 1, 0, clip(hint, max_x), curses.A_DIM)

    def draw_board(self) -> None:
        max_y, max_x = self.stdscr.getmaxyx()
        self.draw_header("Application Board")
        body_top, body_bottom = 2, max_y - 2
        n = len(COLUMN_ORDER)
        col_w = max_x // n
        for i, col in enumerate(COLUMN_ORDER):
            x0 = i * col_w
            w = col_w - 1 if i < n - 1 else max_x - x0
            items = self.opps_in(col)
            label = f"{COLUMN_LABEL[col]} ({len(items)})"
            attr = curses.color_pair(COL_PAIR[col]) | curses.A_BOLD
            if i == self.col:
                attr |= curses.A_UNDERLINE
            safe_addstr(self.stdscr, body_top, x0, clip(label, w), attr)
            y = body_top + 1
            for idx, opp in enumerate(items):
                if y > body_bottom:
                    break
                selected = i == self.col and idx == min(self.row[col], len(items) - 1)
                flag = "! " if opp.todo and opp.todo.open_items else "  "
                tag = f" [{opp.tag}]" if opp.tag else ""
                line1 = clip(f"{flag}{opp.title}{tag}", w)
                line2 = clip(f"   {opp.status_date} · {opp.kind}", w)
                attr1 = curses.color_pair(5) if selected else curses.A_BOLD
                attr2 = curses.color_pair(5) if selected else curses.A_DIM
                safe_addstr(self.stdscr, y, x0, line1.ljust(w) if selected else line1, attr1)
                y += 1
                if y <= body_bottom:
                    safe_addstr(self.stdscr, y, x0, line2.ljust(w) if selected else line2, attr2)
                    y += 1
                y += 1  # blank line between cards
        hint = "←/→ column  ↑/↓ card  enter view  t todo  r reload  q quit"
        if self.message:
            hint = f"{self.message}  |  {hint}"
        self.draw_footer(hint)

    def draw_detail(self) -> None:
        opp = self.selected()
        max_y, max_x = self.stdscr.getmaxyx()
        if not opp:
            self.mode = "board"
            return
        self.draw_header(opp.title)
        lines: list[tuple[str, int]] = []
        tag = f"  [{opp.tag}]" if opp.tag else ""
        lines.append((f"Status: {opp.state}{tag}, {opp.status_date}", curses.A_BOLD))
        if opp.note:
            lines.append((f"  {opp.note}", curses.A_DIM))
        lines.append((f"Kind: {opp.kind}   Path: {opp.path.parent}", curses.A_DIM))
        lines.append(("", 0))
        for raw in opp.body.splitlines():
            if raw.startswith("**Status:**") or (raw.startswith("# ") and raw[2:].strip() == opp.title):
                continue
            if raw.startswith("## "):
                lines.append((raw[3:].strip(), curses.A_BOLD | curses.color_pair(1)))
            elif raw.startswith("### "):
                lines.append((raw[4:].strip(), curses.A_BOLD))
            else:
                lines.append((raw, 0))
        if opp.todo:
            lines.append(("", 0))
            lines.append((f"Open actions (TODO.md — {opp.todo.heading})", curses.A_BOLD | curses.color_pair(1)))
            for item in opp.todo.open_items:
                lines.append((f"  ☐ {item}", curses.color_pair(6)))
            for item in opp.todo.done_items:
                lines.append((f"  ☑ {item}", curses.A_DIM))
            if not opp.todo.open_items and not opp.todo.done_items:
                lines.append(("  (section present, no checklist items)", curses.A_DIM))
        else:
            lines.append(("", 0))
            lines.append(("No matching section in TODO.md.", curses.A_DIM))

        body_top, body_bottom = 2, max_y - 2
        visible = body_bottom - body_top
        self.scroll = max(0, min(self.scroll, max(0, len(lines) - visible)))
        for i, (text, attr) in enumerate(lines[self.scroll : self.scroll + visible]):
            safe_addstr(self.stdscr, body_top + i, 0, clip(text, max_x), attr)
        self.draw_footer("↑/↓ scroll  PgUp/PgDn  b/esc back  q quit")

    def draw_todo(self) -> None:
        max_y, max_x = self.stdscr.getmaxyx()
        self.draw_header("TODO.md")
        lines: list[tuple[str, int]] = []
        if not self.todo_sections:
            lines.append(("TODO.md is empty — nothing open.", curses.A_DIM))
        for section in self.todo_sections:
            open_items = section.open_items
            done_items = section.done_items
            marker = "" if open_items else "  (clear)"
            lines.append((f"{section.heading}{marker}", curses.A_BOLD | curses.color_pair(1)))
            for item in open_items:
                lines.append((f"  ☐ {item}", curses.color_pair(6) | curses.A_BOLD))
            for item in done_items:
                lines.append((f"  ☑ {item}", curses.A_DIM))
            if not open_items and not done_items:
                for raw in section.lines:
                    if raw.strip():
                        lines.append((f"  {raw.strip()}", 0))
            lines.append(("", 0))

        body_top, body_bottom = 2, max_y - 2
        visible = body_bottom - body_top
        self.scroll = max(0, min(self.scroll, max(0, len(lines) - visible)))
        for i, (text, attr) in enumerate(lines[self.scroll : self.scroll + visible]):
            safe_addstr(self.stdscr, body_top + i, 0, clip(text, max_x), attr)
        self.draw_footer("↑/↓ scroll  PgUp/PgDn  b/esc/t back to board  q quit")


def main(argv: list[str]) -> int:
    root = repo_root()
    if "--list" in argv or not sys.stdout.isatty():
        if not sys.stdout.isatty() and "--list" not in argv:
            print("(not a tty — showing a plain listing; run this in a real terminal for the interactive board)\n", file=sys.stderr)
        print_plain(load(root))
        return 0
    curses.wrapper(lambda stdscr: Board(stdscr, root).run())
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
