#!/usr/bin/env bash
# Rebuilds the PDF for any staged .typ file and stages the result, so a commit
# never ships a resume PDF that's stale relative to its source.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

mapfile -t changed_typ < <(git diff --cached --name-only --diff-filter=ACM -- '*.typ')

if [ "${#changed_typ[@]}" -eq 0 ]; then
    exit 0
fi

if [ ! -d .fonts ]; then
    echo "pre-commit: .fonts/ missing, running 'just install-fonts'..."
    just install-fonts
fi

for file in "${changed_typ[@]}"; do
    # template.typ has no resume to render standalone (the `resume()` call lives in
    # each application's .typ) — compiling it here would produce and stage a
    # meaningless template.pdf. Application .typ changes already recompile against
    # this template, so a broken template.typ still gets caught below.
    if [ "$file" = "template.typ" ]; then
        continue
    fi

    echo "pre-commit: compiling $file"
    if ! typst compile --root . --font-path .fonts $(just _stamp "$file") "$file"; then
        echo "pre-commit: typst compile failed for $file — aborting commit" >&2
        exit 1
    fi
    pdf="${file%.typ}.pdf"
    git add "$pdf"
    case "$file" in
        applications/* | grants/*)
            if ! hooks/check-layout "$file"; then
                echo "pre-commit: awkward page break in $file — fix it or commit with --no-verify" >&2
                exit 1
            fi
            ;;
    esac
done

if printf '%s\n' "${changed_typ[@]}" | grep -qx 'template.typ'; then
    echo "pre-commit: template.typ changed, recompiling every resume to verify..."
    shopt -s nullglob
    for f in applications/*/*.typ applications/completed/*/*.typ grants/*/*.typ grants/completed/*/*.typ; do
        # Skip gitignored documents. Their PDFs can't be staged, and `git add` on an
        # ignored path exits non-zero, which under `set -e` aborted the whole commit —
        # so any template.typ change was unable to be committed at all.
        if git check-ignore -q "$f"; then
            echo "pre-commit: skipping ignored $f"
            continue
        fi
        echo "pre-commit: compiling $f"
        if ! typst compile --root . --font-path .fonts $(just _stamp "$f") "$f"; then
            echo "pre-commit: typst compile failed for $f — aborting commit" >&2
            exit 1
        fi
        git add "${f%.typ}.pdf"
        if ! hooks/check-layout "$f"; then
            echo "pre-commit: awkward page break in $f — fix it or commit with --no-verify" >&2
            exit 1
        fi
    done
fi
