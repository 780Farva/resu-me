.fonts/

# hooks/board.ts has no dependencies, but `bun install`/an editor may still create these.
node_modules/
bun.lock
bun.lockb

# Personal Claude Code files — local to each checkout, never shared or forked. See
# https://code.claude.com/docs/en/settings.md#key-configuration-files.
CLAUDE.local.md
.claude/settings.local.json

# Local-only, never committed: the signature raster and anything built with it.
# A signature can't be rotated the way a phone number can, and a clean raster of one is
# the input to signing things you didn't sign. `just sign <name>` writes signed PDFs in
# here; the committed PDFs carry the typed name instead. See CLAUDE.md.
.private/

# A standalone compile of template.typ produces a meaningless one-page PDF (the resume()
# call lives in each application, not here). The pre-commit hook skips building it; this
# keeps a stray manual `typst compile template.typ` out of the tree.
template.pdf
